{
  "name": "datera-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "pnpm -w exec tsc -b && node packages/testkit/dist/make-fixtures.js",
    "desktop": "pnpm --filter @datera/desktop dev",
    "stage-extensions": "node scripts/stage-extensions.mjs",
    "postinstall": "node scripts/stage-extensions.mjs || echo \"extension staging skipped\"",
    "try": "tsc -b && node scripts/try-core.mjs"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "@datera/core": "workspace:*",
    "@datera/node-runtime": "workspace:*"
  }
}
